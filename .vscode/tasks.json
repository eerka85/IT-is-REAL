{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\w64devkit\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-IC:\\raylib\\include",
                "C:\\raylib\\lib\\libraylib.a", // Point directly to the static file
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-static",             // Add this flag to tell GCC to link system libs statically
                "-static-libgcc",      // Add this to include GCC runtime libraries
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
